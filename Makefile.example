# Makefile.example — copy to your project root as `Makefile` and adapt.
# Four targets: dev (local + DB in Docker), run (all in Docker), seed, clean.

# ─── Config ──────────────────────────────────────────────────────────────────
APP_NAME   ?= myapp
DB_NAME    ?= $(APP_NAME)_dev
DB_PORT    ?= 5432
DB_IMAGE   ?= postgres:16
# Common alternatives:
#   MongoDB:  DB_IMAGE=mongo:7,     DB_PORT=27017
#   MySQL:    DB_IMAGE=mysql:8,     DB_PORT=3306
#   Redis:    DB_IMAGE=redis:7,     DB_PORT=6379

# Detect package manager
ifeq ($(wildcard pnpm-lock.yaml),pnpm-lock.yaml)
  PM := pnpm
else ifeq ($(wildcard yarn.lock),yarn.lock)
  PM := yarn
else ifeq ($(wildcard bun.lockb),bun.lockb)
  PM := bun
else
  PM := npm run
endif

# ─── Targets ─────────────────────────────────────────────────────────────────

.PHONY: dev run seed clean help

## dev — Run app locally (hot-reload). Start DBs in Docker if not running.
dev:
	@echo "Starting database ($(DB_IMAGE) on port $(DB_PORT))..."
	@docker ps --format '{{.Ports}}' | grep -q "$(DB_PORT)" || \
	  (docker run -d --name $(APP_NAME)-db \
	    -p $(DB_PORT):$(DB_PORT) \
	    -e POSTGRES_DB=$(DB_NAME) \
	    -e POSTGRES_PASSWORD=dev \
	    $(DB_IMAGE) && sleep 2)
	@echo "Database ready."
	@echo "Starting app (developer mode)..."
	$(PM) dev

## run — Start everything in Docker (app + all DBs). Good for full-stack testing.
run:
	docker compose up --build

## seed — Load dev accounts and fixture data into the running database.
seed:
	$(PM) seed

## clean — Stop all containers, remove volumes, wipe all data (destructive).
clean:
	@echo "WARNING: This will delete all containers and data."
	@printf "Press Enter to continue, Ctrl+C to cancel: " && read _
	docker compose down -v --remove-orphans
	docker rm -f $(APP_NAME)-db 2>/dev/null || true
	docker volume ls -q | grep $(APP_NAME) | xargs docker volume rm 2>/dev/null || true
	@echo "Clean complete."

## help — List available targets.
help:
	@grep -E '^## ' Makefile | sed 's/## //'
